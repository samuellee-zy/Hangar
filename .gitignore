# Every rule here says what writes the thing it ignores. An ignore file nobody can explain
# accretes junk, and the entries that matter get lost among the ones that don't.
#
# Note: gitignore has no trailing comments — `out/ # build output` would be read as a pattern
# containing spaces and a hash. Comments live on their own lines.

# --- dependencies and build output -------------------------------------------------------------

node_modules/

# electron-vite
out/

# electron-builder: the DMGs and the unpacked .app
dist/

# vitest --coverage
coverage/

# `npm run graph` — a rendered view of what .dependency-cruiser.cjs already specifies.
dependency-graph.svg

# A stale bundled main process the build has emitted at the repo root before now. Root-anchored
# deliberately, so it cannot also hide src/**/index.js.
/index.js

# --- secrets ------------------------------------------------------------------------------------
#
# Nothing here uses any of these today. They are listed pre-emptively because a signing certificate
# and a .env are the two things most likely to arrive in an Electron repo later — and an ignore rule
# added after the fact does not help, because git history is permanent.

.env
.env.*
*.pem
*.key
*.p12
*.cer
*.mobileprovision

# --- Hangar's own runtime files -------------------------------------------------------------------
#
# THE ONES THAT MATTER. Config sync writes `hangar.config.json` into whatever repo `sync.repoPath`
# points at. Point it here and your service names, account labels, custom connection URLs and any
# customJs are committed. No credentials — those are stripped, see core/config/sync.ts — but plenty
# of internal topology. `sync-base.json` is the last-synced snapshot. The `corrupt-*` files are
# quarantined configs, which are whole configs by definition.

hangar.config.json
sync-base.json
config.json.corrupt-*

# Root-anchored: a bare `config.json` would match at any depth and could shadow a legitimate
# nested one later. The realistic accident is dropping your userData config at the repo root.
/config.json

# --- generated assets -----------------------------------------------------------------------------
#
# scripts/make-icon.mjs renders these from an SVG written inline in that script, so they are
# reproducible with `npm run icon` and don't belong in git as binaries.

build/icon.icns
build/icon.png
build/icon.iconset/

# --- Playwright -----------------------------------------------------------------------------------

test-results/
playwright-report/
blob-report/
.playwright/

# --- Phase 0 spike ----------------------------------------------------------------------------------
#
# `sessions/` is real Chromium cookie jars from the Google login research — 800+ MB and genuinely
# sensitive. The spike's source is committed; its state is not.

spikes/*/sessions/
spikes/*/sessions-headless/
spikes/*/results.json
spikes/*/results.md
spikes/*/probe-results.json

# --- tooling caches -----------------------------------------------------------------------------

# Removed along with the esbuild harness; kept so older checkouts stay clean.
out-check/
.eslintcache
*.tsbuildinfo

# --- logs ---------------------------------------------------------------------------------------

*.log
npm-debug.log*
yarn-error.log*

# --- editors and OS -----------------------------------------------------------------------------

.DS_Store
.vscode/
.idea/
*.swp
*~
