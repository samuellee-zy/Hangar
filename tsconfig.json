{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    // The actual root cause of the Phase 7 P0: a python slice deleted the entire application
    // lifecycle block — persistAll, both background loops, powerMonitor, before-quit — and left
    // ELEVEN imports referenced only by their own import statement. tsc passed, 347 unit tests
    // passed, dependency-cruiser passed, 12 Playwright tests passed. Dead code that large should
    // be a build failure, not something an audit has to notice weeks later.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@main/*": ["src/main/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  // tests/ is typechecked by tsconfig.test.json (`npm run typecheck:tests`), which extends this one
  // and relaxes the two rules that are friction in fixtures. See docs/backlog.md §10.
  "include": ["src/**/*.ts", "src/**/*.tsx", "electron.vite.config.ts", "vitest.config.ts"]
}
