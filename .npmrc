# Pin the registry to public npm.
#
# Without this, `npm install` inherits whatever registry ~/.npmrc sets. A private corporate feed
# there wrote four of its own URLs into package-lock.json — `@playwright/test`, `playwright`,
# `playwright-core` and `fsevents` — which then published an internal feed URL to a public repo and
# broke CI with E401, since nobody outside that org can authenticate to it.
#
# Registry-only. Never put a token in this file; it is committed.
registry=https://registry.npmjs.org/
