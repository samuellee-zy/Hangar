{
  "name": "hangar",
  "productName": "Hangar",
  "version": "0.1.0",
  "description": "A unified workspace for web apps \u2014 one window, isolated sessions, no subscription.",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "check": "npm run typecheck && npm run typecheck:tests && vitest run && npm run check:boundaries",
    "check:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "graph": "depcruise src --config .dependency-cruiser.cjs --output-type dot | dot -T svg > dependency-graph.svg",
    "icons": "node scripts/fetch-icons.mjs",
    "icon": "electron scripts/make-icon.mjs",
    "dist": "npm run build && npm run icon && electron-builder --mac -c.mac.identity=null",
    "dist:signed": "npm run build && npm run icon && electron-builder --mac",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eneris/push-receiver": "^4.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "author": {
    "name": "Samuel Lee"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuellee-zy/Hangar.git"
  },
  "bugs": {
    "url": "https://github.com/samuellee-zy/Hangar/issues"
  },
  "homepage": "https://github.com/samuellee-zy/Hangar#readme"
}