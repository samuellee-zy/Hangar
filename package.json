{
  "name": "hangar",
  "productName": "Hangar",
  "version": "0.1.0",
  "description": "A unified workspace for web apps — one window, isolated sessions, no subscription.",
  "main": "out/main/index.js",
  "private": true,
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "node scripts/run-electron.mjs electron-vite dev",
    "dev:isolated": "node scripts/run-electron.mjs --profile \"Hangar (dev)\" electron-vite dev",
    "build": "electron-vite build",
    "start": "node scripts/run-electron.mjs electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run typecheck:tests && npm run lint && vitest run && npm run check:boundaries",
    "check:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "graph": "depcruise src --config .dependency-cruiser.cjs --output-type dot | dot -T svg > dependency-graph.svg",
    "icons": "node scripts/fetch-icons.mjs",
    "icon": "node scripts/run-electron.mjs electron scripts/make-icon.mjs",
    "dist": "npm run build && npm run icon && electron-builder --mac -c.mac.identity=null",
    "dist:signed": "npm run build && npm run icon && electron-builder --mac",
    "install:local": "node scripts/install-local.mjs",
    "cert:local": "node scripts/make-signing-cert.mjs",
    "test:e2e": "npm run build && playwright test",
    "shots": "npm run build && playwright test -c playwright.shots.config.ts",
    "postinstall": "install-electron"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron/asar": "^3.4.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@eneris/push-receiver": "^4.3.1",
    "@ghostery/adblocker-electron": "^2.18.2"
  },
  "author": {
    "name": "Samuel Lee"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuellee-zy/Hangar.git"
  },
  "bugs": {
    "url": "https://github.com/samuellee-zy/Hangar/issues"
  },
  "homepage": "https://github.com/samuellee-zy/Hangar#readme"
}
